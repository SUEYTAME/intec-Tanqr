# Copia este archivo a .env y rellena los valores. .env NUNCA se comitea.

# --- Base de datos (ADR-002) ---
POSTGRES_USER=combustible
# Obligatoria: define tu propia contraseña local; no hay valor por defecto.
POSTGRES_PASSWORD=
POSTGRES_DB=combustible
POSTGRES_PORT=15432

# Usuario SQL limitado y cuenta inicial local; scripts/config-local.ps1 genera secretos.
APP_DB_PASSWORD=
BOOTSTRAP_EMAIL=admin@localhost.test
BOOTSTRAP_PASSWORD=

# --- Firma de los QR (RF-07, RS-04) ---
# Clave privada ECDSA P-256 (PKCS#8 PEM) codificada en base64. Obligatoria: la API no arranca sin ella.
# scripts/config-local.ps1 la genera si falta. Cambiarla invalida los QR de tickets ya emitidos.
QR_SIGNING_KEY_B64=

# --- Firma de tokens OAuth 2.0 (RS-05, clientes de integración de RF-24) ---
# Clave ECDSA P-256 (PKCS#8 PEM) en base64, distinta de la del QR. config-local.ps1 la genera.
OAUTH_SIGNING_KEY_B64=

# --- Cifrado en reposo AES-256 (RS-03) ---
# 32 bytes aleatorios en base64. Obligatoria. Perderla hace ilegibles los campos cifrados.
DATA_ENCRYPTION_KEY=

# URL pública de la web; se usa en el enlace seguro del ticket (RF-09).
PUBLIC_BASE_URL=http://localhost:5173

# --- JWT (RS-01, RS-05) ---
# Base64 de al menos 32 bytes aleatorios; no reutilizar en producción.
JWT_SIGNING_KEY=
JWT_ISSUER=intec-combustible
JWT_AUDIENCE=intec-combustible

# --- Correo (RF-06, RF-09) — bloqueo B-02 para producción ---
# En local, config-local.ps1 apunta al Mailpit de docker-compose (127.0.0.1:11025, bandeja en
# http://127.0.0.1:18025). SMTP_HOST vacío en la API = bandeja a disco artifacts/outbox (nunca "enviado").
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true exige STARTTLS (producción). false solo para el servidor local de desarrollo.
SMTP_REQUIRE_TLS=
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025

# --- SMS (RF-09) — bloqueo B-01 ---
# Sin pasarela contratada: el SMS se escribe en artifacts/outbox y se informa como "Outbox".
# SMS_PROVIDER=twilio activa la API real. Exactamente uno de From/MessagingServiceSid.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Demo temporal: plantilla genérica de Twilio, sin datos del ticket. Ambas o ninguna.
TWILIO_TRIAL_TEMPLATE=
TWILIO_TRIAL_UNTIL=
SMS_API_KEY=
SMS_SENDER_ID=
