# Copia este archivo a .env y rellena los valores. .env NUNCA se comitea.

# --- Base de datos (ADR-002) ---
POSTGRES_USER=combustible
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=combustible
POSTGRES_PORT=5432

# --- Firma de los QR (RF-07, RS-04) ---
# Clave privada ECDSA P-256 en PEM, en base64. Se genera con scripts/generar-clave-qr.
# Si falta, la API debe FALLAR al arrancar, no arrancar sin firma.
QR_SIGNING_KEY_B64=

# --- JWT (RS-01, RS-05) ---
JWT_SIGNING_KEY=
JWT_ISSUER=intec-combustible
JWT_AUDIENCE=intec-combustible

# --- Correo (RF-06, RF-09) — bloqueo B-02 ---
# Vacio = se usa la implementacion de desarrollo que escribe a artifacts/outbox/ (ADR-005).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- SMS (RF-09) — bloqueo B-01 ---
# Vacio = implementacion de desarrollo a disco. NUNCA simular un envio exitoso.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
