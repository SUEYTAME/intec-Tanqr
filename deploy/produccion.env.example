# Plantilla. Copiar a deploy/produccion.env (ignorado por Git) y completar. NUNCA comitear valores reales.
# Claves (generar en una máquina segura):
#   openssl rand -base64 32                     → JWT_SIGNING_KEY, DATA_ENCRYPTION_KEY
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | base64 -w0
#                                               → QR_SIGNING_KEY_B64 y OAUTH_SIGNING_KEY_B64 (una distinta cada una)
# DATA_ENCRYPTION_KEY y QR_SIGNING_KEY_B64 NO se rotan sin migración: perderlas = perder datos
# personales cifrados y la validez de los tickets emitidos. Guardar copia fuera del servidor.
APP_VERSION=0.4.0
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=combustible
APP_DB_PASSWORD=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
JWT_SIGNING_KEY=
DATA_ENCRYPTION_KEY=
QR_SIGNING_KEY_B64=
OAUTH_SIGNING_KEY_B64=
# URL pública con la que se construyen los enlaces de ticket (RF-09), p. ej. https://combustible.intec.edu.do
PUBLIC_BASE_URL=
# B-02: SMTP institucional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# B-01: SMS (Twilio). Vacío conserva Outbox; usar exactamente un remitente.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# B-03: carpeta del servidor que contiene tls.pfx (certificado del dominio) y su contraseña
TLS_PFX_DIR=
TLS_PFX_PASSWORD=
